# Fichiers personnels — ne jamais publier.
# Ancrés à la racine : c'est là que le scanner et la page les déposent.
# Sans la barre oblique initiale, la règle s'applique aussi à tests/, et un
# fichier de test finit ignoré sans que rien ne le signale avant la CI.
/profil-*.json
/inventaire-*.json
/progression-*.json
/winget-*.json
/winget-*.ps1
/migration-pc.txt

# Node
node_modules/

# Produits par les scripts de scan a cote de la page. resultat-scan.js decrit
# la machine de celui qui l'a lance, et la page le charge a l'ouverture :
# versionne, il partirait en ligne et s'appliquerait chez tous les visiteurs.
/resultat-scan.js
# Le relais entre les deux PC : le scan de la source le pose a cote de la page
# pour que celui de la cible le retrouve. Il decrit une machine reelle.
/instantane-source.json
/instantane-source-*.json
/instantane-cible-*.json
/verification-pc.json
# Produit par scripts/diagnostic.ps1 a cote de lui. Il ne porte aucun nom de
# logiciel ni de machine, mais un message d'erreur peut contenir un chemin :
# il n'a pas a etre versionne.
/scripts/diagnostic-migration-pc.txt
migration-pc.zip
